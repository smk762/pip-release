# X (Twitter) OAuth 1.0a user tokens. A post that contains a URL is billed
# at the URL rate on the X developer console. Check the current price before
# approving those drafts.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Discord incoming webhook for the announcement channel.
DISCORD_WEBHOOK_URL=

# Telegram bot that is an administrator of the announcement channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional HTTPS endpoint that receives a JSON body when drafts are waiting.
# HTTP is accepted only for localhost.
PIP_RELEASE_REVIEW_WEBHOOK=

# Review UI. Leave the token empty to open http://127.0.0.1:8787/ with no login.
# Docker listens beyond loopback inside the container, so the review service
# refuses to start until PIP_RELEASE_UI_TOKEN is set. PIP_RELEASE_UI_SECRET
# keeps you signed in across restarts.
PIP_RELEASE_UI_TOKEN=
PIP_RELEASE_UI_SECRET=
PIP_RELEASE_UI_URL=http://127.0.0.1:8787
